{
  "commands": {
    "cmd_gemini": "am start --user 0 -f 0x10000000 -n com.google.android.apps.bard/.shellapp.BardEntryPointActivity 2>/dev/null || am start --user 0 -f 0x10000000 -n com.google.android.apps.googleassistant/.AssistantActivity 2>/dev/null || am start --user 0 -f 0x10000000 -a android.intent.action.VOICE_COMMAND 2>/dev/null || input keyevent 231",
    "cmd_camera": "am start --user 0 -f 0x10000000 -a android.media.action.STILL_IMAGE_CAMERA",
    "cmd_youtube_revanced": "am start --user 0 -f 0x10000000 -n com.google.android.youtube/com.google.android.apps.youtube.app.watchwhile.WatchWhileActivity 2>/dev/null || am start --user 0 -f 0x10000000 -n app.revanced.android.youtube/com.google.android.apps.youtube.app.watchwhile.WatchWhileActivity",
    "cmd_recorder": "am start --user 0 -f 0x10000000 -a android.provider.MediaStore.RECORD_SOUND 2>/dev/null || am start --user 0 -f 0x10000000 -n com.google.android.apps.recorder/.main.MainActivity",
    "cmd_translate": "am start --user 0 -f 0x10000000 -n com.google.android.apps.translate/.TranslateActivity 2>/dev/null || am start --user 0 -f 0x10000000 -n com.google.android.apps.translate/com.google.android.apps.translate.HomeActivity",
    "cmd_flashlight": "sh /data/adb/h2os/flashlight.sh",
    "cmd_ringer": "sh /data/adb/h2os/ringer.sh"
  }
}
